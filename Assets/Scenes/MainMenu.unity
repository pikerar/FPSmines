--- !u!114 &1418908069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1418908068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3ab72a0e7362d9343aaaa2dbb2d67aa9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  targetText: {fileID: 1876940708}
  memories:
  - "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u0439
    \u043E \u043F\u0440\u0430\u0432\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E."
  - "\u0422\u043E\u0442, \u0443 \u043A\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u0442
    \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u0438 \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F
    \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u0432\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432\u043E \u043C\u0440\u0430\u043A, \u043F\u0435\u0440\u0432\u044B\u043C \u0443\u0432\u0438\u0434\u0438\u0442
    \u0432 \u043D\u0435\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u0441\u043A \u0441\u0432\u0435\u0442\u0430"
  - "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
    \u043B\u0438 \u044F \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0438\u043B\u0438
    \u043D\u0435\u0442... \u0438, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0443\u0437\u043D\u0430\u044E.
    \u041D\u043E \u044F \u0441\u0434\u0435\u043B\u0430\u043B \u0432\u044B\u0431\u043E\u0440.
    \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D \u0431\u044B\u043B \u0432\u0435\u0440\u043D\u044B\u043C."
  - "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u043E\u0439\u0442\u0438\u0441\u044C
    \u0431\u0435\u0437 \u0432\u0441\u0435\u0433\u043E. \u041D\u043E \u043D\u0430\u0434\u0435\u0436\u0434\u0430
    \u0443 \u043D\u0435\u0433\u043E \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
    \u0432\u0441\u0435\u0433\u0434\u0430."
  - "\u0412 \u0441\u043F\u043E\u0440\u0430\u0445 \u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F
    \u0438\u0441\u0442\u0438\u043D\u0430, \u0431\u0443\u0434\u044C \u043E\u043D\u0430
    \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0430."
  - "\u0412 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435 \u0441\u043A\u0430\u0437\u043A\u0438
    \u044F \u0432\u0435\u0440\u044E! \u0412 \u0434\u043E\u0431\u0440\u044B\u0435
    \u2013 \u043D\u0435\u0442. \u0410 \u0432 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435
    \u2013 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0433\u043E\u0434\u043D\u043E!"
  - "\u041B\u0443\u0447\u0448\u0435 \u0443\u0436 \u0433\u043E\u0440\u044C\u043A\u043E\u0435
    \u0441\u0447\u0430\u0441\u0442\u044C\u0435, \u0447\u0435\u043C \u0441\u0435\u0440\u0430\u044F,
    \u0443\u043D\u044B\u043B\u0430\u044F \u0436\u0438\u0437\u043D\u044C\u2026"
