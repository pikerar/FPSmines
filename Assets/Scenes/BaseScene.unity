  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3a128d1db91d2c41b2ef70d5d3c46e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cameraFocus: {fileID: 9198153747895333728}
  subtitles: {fileID: 842580287297736220}
  intercomTarget: {fileID: 4601439901659278055}
  lines:
  - "\u0416\u0438\u0432\u043E\u0439, \u0437\u043D\u0430\u0447\u0438\u0442. "
  - "\u041D\u0435\u043F\u043B\u043E\u0445\u043E, \u043D\u0435\u043F\u043B\u043E\u0445\u043E."
  - "\u0412\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u043F\u043E\u043B\u0435
    \u043F\u0440\u043E\u0448\u0451\u043B - \u043D\u0435\u043F\u043B\u043E\u0445\u043E
    \u0434\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F. "
  - "\u0422\u043E\u043B\u044C\u043A\u043E \u0434\u0430\u043B\u044C\u0448\u0435 \u0442\u0430\u043A
    \u043D\u0435 \u043F\u0440\u043E\u043A\u0430\u0442\u0438\u0442"
  - "\u0444\u043B\u0430\u0433\u0438, \u043E\u0431\u044B\u0447\u043D\u043E, \u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F
    \u0440\u0430\u043D\u044C\u0448\u0435 \u043C\u0438\u043D."
  - "\u0411\u0443\u0434\u0435\u0448\u044C \u0431\u0435\u0433\u0430\u0442\u044C \u043E\u0442
    \u043F\u043E\u043B\u044F \u0434\u043E \u044F\u0449\u0438\u043A\u0430, \u0447\u0442\u043E\u0431\u044B
    \u0444\u043B\u0430\u0433\u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
  - "\u0418 \u0442\u0430\u043A \u043F\u043E \u043A\u0440\u0443\u0433\u0443, \u043F\u043E\u043A\u0430
    \u0432\u0441\u0451 \u043D\u0435 \u0443\u0431\u0435\u0440\u0451\u0448\u044C."
  - "\u0412\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E,
    \u0438\u0434\u0438 \u043D\u0430 \xAB\u0411\u0435\u0442\u0443\xBB, \u0442\u0430\u043C
    \u0434\u0430\u043B\u044C\u0448\u0435 \u0442\u0435\u0431\u0435 \u0438 \u043A\u043F\u043A
    \u043B\u0438\u0447\u043D\u044B\u0439 \u0432\u044B\u0434\u0430\u0434\u0443\u0442,
    \u043D\u043E \u0442\u044B \u0434\u043E\u0436\u0438\u0432\u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430."
